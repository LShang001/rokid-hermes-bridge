# Rokid 眼镜配对信息
ROKID_LINK_CODE=your_link_code
ROKID_LINK_SECRET=your_link_secret

# Hermes Gateway
HERMES_API_KEY=your_hermes_api_key
HERMES_BASE_URL=http://127.0.0.1:8642

# 思考强度：off / low / medium / high
# 眼镜是语音交互，首字延迟比答案深度重要，默认 off（实测首字 5.2s → 2.1s）
# 逐请求生效，不影响你在电脑上用 Hermes CLI 的配置
# HERMES_REASONING=off

# Rokid 云 WebSocket（通常不需要改）
# ROKID_WS_URL=wss://rcs.rokid.com/claw/ws/link

# 重连配置
# ROKID_RECONNECT_MAX=10
# ROKID_RECONNECT_DELAY=1000

# 多轮上下文：空闲超过这么久就开新会话（秒，默认 600 = 10 分钟）
# 会话内 Hermes 会把历史回灌进 prompt，太长会拖慢首字延迟
# ROKID_SESSION_IDLE_SEC=600
